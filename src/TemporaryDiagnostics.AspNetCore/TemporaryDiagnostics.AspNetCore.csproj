<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <Description>ASP.NET Core integration for TemporaryDiagnostics: Middleware, Minimal APIs, embedded Vue 3 SPA UI, and OpenAPI docs.</Description>
    <NoWarn>$(NoWarn);NU1903;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TemporaryDiagnostics.Core\TemporaryDiagnostics.Core.csproj" />
    <ProjectReference Include="..\TemporaryDiagnostics.Infrastructure\TemporaryDiagnostics.Infrastructure.csproj" />
  </ItemGroup>
</Project>
